{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "description": "Bundles the application with Vite",
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "//#format-and-lint": {
      "description": "Repo-wide biome check; uncached because root-task hashing misses workspace files",
      "cache": false
    },
    "//#format-and-lint:fix": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "web#dev": {
      "cache": false,
      "persistent": true,
      "with": ["api#dev"]
    },
    "test": {
      "description": "Runs the package's test suite"
    },
    "check-types": {
      "description": "Type-checks the package without emitting output"
    },
    "lint": {
      "description": "Non-mutating format and refactor-drift checks for the package"
    }
  }
}
