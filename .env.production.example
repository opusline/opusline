# Opusline, self-hosted. Copy to `.env` beside compose.prod.yaml and fill in.
#
# This is not apps/api/.env.example — that one is the development Sail
# environment (APP_DEBUG=true, a password of "password", MinIO credentials in
# clear) and copying it into production is how a stack trace with your bucket
# path ends up in a browser.

# ------------------------------------------------------------------ Identity --

APP_NAME=Opusline
APP_ENV=production
APP_DEBUG=false

# The public URL, scheme included. Sanctum derives the stateful domain from it,
# so getting it wrong shows up as intermittent 419s on every write.
APP_URL=https://opusline.example.com

# Generate once and never lose it: it decrypts existing sessions, cookies and
# the calendar tokens already handed out.
#   docker run --rm ghcr.io/opusline/opusline-api php artisan key:generate --show
APP_KEY=

# Only when rotating APP_KEY: the old keys, comma separated, so sessions issued
# under them keep working until they expire.
APP_PREVIOUS_KEYS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ----------------------------------------------------------------- Sessions --

# The four settings a TLS-terminating proxy makes load-bearing. Without the
# first two the session cookie is issued without the Secure attribute and
# scoped to the wrong host, which reads as "logs me out at random".
SESSION_DRIVER=redis
SESSION_DOMAIN=opusline.example.com
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120

# The hosts allowed to hold a session cookie. Defaults to APP_URL's host; set it
# explicitly when the app answers on more than one name.
SANCTUM_STATEFUL_DOMAINS=opusline.example.com

# The app sits behind `web` in compose.prod.yaml and is not otherwise reachable,
# so the forwarded headers can be believed. Narrow this to the proxy's address
# if you expose the API container directly — see docs/self-hosting.md.
TRUSTED_PROXIES=*

# Tells Laravel to build https:// URLs even though the proxy speaks http to it.
OCTANE_HTTPS=true
OCTANE_SERVER=frankenphp

# ----------------------------------------------------------------- Database --

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=opusline
DB_USERNAME=opusline
# Required — compose.prod.yaml refuses to start without it.
DB_PASSWORD=

# ------------------------------------------------------------ Cache & queue --

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ------------------------------------------------------------------ Storage --

# `local` keeps uploads in the opusline-storage volume — one less service to
# run, and one more thing your backup has to include. Switch to `s3` and fill in
# the AWS_* block below to put them in object storage instead.
FILESYSTEM_DISK=local
MEDIA_DISK=local

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=opusline
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=true

# ------------------------------------------------------------------ Logging --

# stderr, not a file: `docker compose logs api` is where an operator looks, and
# storage/logs is not on a volume — a file there grows unbounded and disappears
# on the next pull.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

# ------------------------------------------------------------- Fiscal rates --

# Reads the official URSSAF barème from mon-entreprise.urssaf.fr once a day.
# Set to false for an air-gapped install; rates then stay whatever you typed.
MON_ENTREPRISE_ENABLED=true
MON_ENTREPRISE_URL=https://mon-entreprise.urssaf.fr/api/v1

# -------------------------------------------------------------------- Image --

# Pin a release instead of tracking latest, so an upgrade is a decision.
# OPUSLINE_VERSION=0.19.0

# The port `web` publishes on the host, for your TLS proxy to forward to.
HTTP_PORT=8080
