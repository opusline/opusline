# The one origin the browser talks to.
#
# Session auth rides an XSRF cookie, so the SPA and the API have to look like the
# same site — apps/web/src/lib/api.ts calls `/api` and `/sanctum` with no
# configurable base URL, deliberately. That makes this file part of the product,
# not deployment garnish: point the SPA at a second hostname and login stops
# working with intermittent 419s.
#
# TLS is not terminated here. Put this behind whatever already holds your
# certificate (a Caddy, an nginx, a Traefik, a tunnel) and forward to :80; see
# docs/self-hosting.md for the two headers that reverse proxy has to send.

:80 {
	log {
		output stdout
		format console
	}

	encode zstd gzip

	# Baseline hardening on every response, API included. HSTS is not set here
	# on purpose: it belongs at the TLS proxy in front, the thing that actually
	# speaks https. frame-ancestors covers what X-Frame-Options does in current
	# browsers; both are sent for older ones. The CSP is a `?` default so the
	# API's own, stricter policies (default-src 'none' on served uploads) pass
	# through untouched; a full CSP on the SPA would need the inline theme
	# script in apps/web/index.html hashed or externalized first.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		?Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "same-origin"
	}

	# /up is Laravel's health endpoint, reachable through the same origin as
	# everything else so an orchestrator has one address to probe.
	@api path /api/* /sanctum/* /up

	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}

	handle {
		root * /srv

		# Hashed filenames, so they can be cached for a year. Everything else —
		# index.html above all, since it points at the current hashes — must
		# revalidate. Matched with a negated path matcher, not `/index.html`:
		# a navigation to /clients is only rewritten to /index.html by
		# try_files AFTER header directives ran, so a request-path match never
		# fires and the response would ship with no Cache-Control at all,
		# leaving stale post-deploy copies to browser heuristics.
		@immutable path /assets/*
		@html not path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header @html Cache-Control "no-cache"

		# Client-side routing: every unknown path is a route the SPA knows, not a
		# missing file.
		try_files {path} /index.html
		file_server
	}
}
