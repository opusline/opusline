{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/.claude", "!**/vendor"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "zod": "Import from \"zod/mini\" instead - the app only ships the tree-shakable mini build."
            },
            "patterns": [
              {
                "group": ["@radix-ui/**"],
                "message": "The design system is Base UI everywhere - do not add Radix primitives."
              },
              {
                "group": [
                  "react-icons",
                  "react-icons/**",
                  "@heroicons/**",
                  "@fortawesome/**",
                  "@tabler/icons-react",
                  "@tabler/icons-react/**",
                  "@phosphor-icons/**",
                  "@mui/icons-material",
                  "@mui/icons-material/**"
                ],
                "message": "Lucide (lucide-react) is the only icon library."
              }
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["packages/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import from \"zod/mini\" instead - the app only ships the tree-shakable mini build."
                },
                "patterns": [
                  {
                    "group": ["@radix-ui/**"],
                    "message": "The design system is Base UI everywhere - do not add Radix primitives."
                  },
                  {
                    "group": [
                      "react-icons",
                      "react-icons/**",
                      "@heroicons/**",
                      "@fortawesome/**",
                      "@tabler/icons-react",
                      "@tabler/icons-react/**",
                      "@phosphor-icons/**",
                      "@mui/icons-material",
                      "@mui/icons-material/**"
                    ],
                    "message": "Lucide (lucide-react) is the only icon library."
                  },
                  {
                    "group": [
                      "@opusline/web",
                      "@opusline/web/**",
                      "@opusline/api-client",
                      "@opusline/api-client/**"
                    ],
                    "message": "The design system must stay standalone - ui cannot import the app or the API client."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
