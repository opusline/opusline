{
  "root": false,
  "extends": "//",
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!src/routeTree.gen.ts"]
  },
  "overrides": [
    {
      "includes": ["src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import from \"zod/mini\" instead - the app only ships the tree-shakable mini build."
                },
                "patterns": [
                  {
                    "group": ["@/features/**"],
                    "message": "Features must not import other features; compose them in a route. Same-feature imports use relative paths."
                  },
                  {
                    "group": ["@/routes/**", "**/routes/**"],
                    "message": "Features must not import the routes layer."
                  },
                  {
                    "group": ["@radix-ui/**"],
                    "message": "The design system is Base UI everywhere - do not add Radix primitives."
                  },
                  {
                    "group": [
                      "react-icons",
                      "react-icons/**",
                      "@heroicons/**",
                      "@fortawesome/**",
                      "@tabler/icons-react",
                      "@tabler/icons-react/**",
                      "@phosphor-icons/**",
                      "@mui/icons-material",
                      "@mui/icons-material/**"
                    ],
                    "message": "Lucide (lucide-react) is the only icon library."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/**", "src/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Import from \"zod/mini\" instead - the app only ships the tree-shakable mini build."
                },
                "patterns": [
                  {
                    "group": ["@/features/**", "**/features/**"],
                    "message": "lib and components sit below features and must not import them."
                  },
                  {
                    "group": ["@/routes/**", "**/routes/**"],
                    "message": "lib and components must not import the routes layer."
                  },
                  {
                    "group": ["@radix-ui/**"],
                    "message": "The design system is Base UI everywhere - do not add Radix primitives."
                  },
                  {
                    "group": [
                      "react-icons",
                      "react-icons/**",
                      "@heroicons/**",
                      "@fortawesome/**",
                      "@tabler/icons-react",
                      "@tabler/icons-react/**",
                      "@phosphor-icons/**",
                      "@mui/icons-material",
                      "@mui/icons-material/**"
                    ],
                    "message": "Lucide (lucide-react) is the only icon library."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
