{
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts"],
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ES2024",
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"],
      "@opusline/api-client": ["../../packages/api-client/src/index.ts"],
      "@opusline/api-client/client": [
        "../../packages/api-client/src/client.gen.ts"
      ],
      "@opusline/api-client/react-query": [
        "../../packages/api-client/src/@tanstack/react-query.gen.ts"
      ],
      "@opusline/ui/*": ["../../packages/ui/src/*"]
    },
    "noEmit": true
  }
}
