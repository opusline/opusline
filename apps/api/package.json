{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh scripts/bootstrap.sh && vendor/bin/sail up",
    "test": "php artisan config:clear --quiet && php artisan test --compact",
    "check-types": "vendor/bin/phpstan analyse --memory-limit=512M --no-progress",
    "lint": "vendor/bin/pint --test && vendor/bin/rector process --dry-run"
  }
}
