    "components": {
        "securitySchemes": {
            "apiKey": {
                "type": "apiKey",
                "in": "cookie",
                "name": "opusline-session"
            }
        },
        "schemas": {
            "BillingMode": {
                "type": "integer",
                "enum": [
                    0,
                    1,
                    2
                ],
                "x-enum-varnames": [
                    "Daily",
                    "Hourly",
                    "Fixed"
                ],
                "title": "BillingMode"
            },
            "ClientData": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "type": {
                        "$ref": "#/components/schemas/ClientType"
                    },
                    "notes": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "siret": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "vatNumber": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "billingAddress": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "billingContactName": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "billingEmail": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "color": {
                        "$ref": "#/components/schemas/Color"
                    },
                    "paymentTermsDays": {
                        "type": "integer"
                    },
                    "archivedAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": [
                    "id",
                    "slug",
                    "name",
                    "type",
                    "notes",
                    "siret",
                    "vatNumber",
                    "billingAddress",
                    "billingContactName",
                    "billingEmail",
                    "color",
                    "paymentTermsDays",
                    "archivedAt",
                    "createdAt"
                ],
                "title": "ClientData"
            },
            "ClientListData": {
                "type": "object",
                "properties": {
                    "clients": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ClientWithMissionsData"
                        }
                    }
                },
                "required": [
                    "clients"
                ],
                "title": "ClientListData"
            },
            "ClientType": {
                "type": "integer",
                "enum": [
                    0,
                    1,
                    2
                ],
                "x-enum-varnames": [
                    "Direct",
                    "Intermediary",
                    "Internal"
                ],
                "title": "ClientType"
            },
            "ClientWithMissionsData": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "type": {
                        "$ref": "#/components/schemas/ClientType"
                    },
                    "notes": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "siret": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "vatNumber": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "billingAddress": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "billingContactName": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "billingEmail": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "color": {
                        "$ref": "#/components/schemas/Color"
                    },
                    "paymentTermsDays": {
                        "type": "integer"
                    },
                    "archivedAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "missions": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/MissionData"
                        }
                    }
                },
                "required": [
                    "id",
                    "slug",
                    "name",
                    "type",
                    "notes",
                    "siret",
                    "vatNumber",
                    "billingAddress",
                    "billingContactName",
                    "billingEmail",
                    "color",
                    "paymentTermsDays",
                    "archivedAt",
                    "createdAt",
                    "missions"
                ],
                "title": "ClientWithMissionsData"
            },
            "Color": {
                "type": "integer",
                "enum": [
                    0,
                    1,
                    2,
                    3,
                    4,
                    5,
                    6,
                    7
                ],
                "x-enum-varnames": [
                    "Amber",
                    "Terracotta",
                    "Olive",
                    "Sage",
                    "Slate",
                    "Indigo",
                    "Plum",
                    "Stone"
                ],
                "title": "Color"
            },
            "CreateClientData": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                    },
                    "type": {
                        "$ref": "#/components/schemas/ClientType"
                    },
                    "notes": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "siret": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 255
                    },
                    "vatNumber": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 255
                    },
                    "billingAddress": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "billingContactName": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 255
                    },
                    "billingEmail": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "email",
                        "maxLength": 255
                    },
                    "color": {
                        "$ref": "#/components/schemas/Color"
                    },
                    "paymentTermsDays": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 365
                    }
                },
                "required": [
                    "name",
                    "type",
                    "color",
                    "paymentTermsDays"
                ],
                "title": "CreateClientData"
            },
            "CreateMissionData": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                    },
                    "billingMode": {
                        "$ref": "#/components/schemas/BillingMode"
                    },
                    "rate": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "properties": {
                            "amount": {
                                "type": "integer",
                                "minimum": 1
                            },
                            "currency": {
                                "$ref": "#/components/schemas/Currency"
                            }
                        },
                        "required": [
                            "amount",
                            "currency"
                        ]
                    },
                    "endClientName": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "minLength": 1,
                        "maxLength": 255
                    },
                    "rounding": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/EntryRounding"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "craRequired": {
                        "type": [
                            "boolean",
                            "null"
                        ]
                    },
                    "color": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/Color"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "notes": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "startDate": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date"
                    },
                    "endDate": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date"
                    }
                },
                "required": [
                    "name",
                    "billingMode"
                ],
                "title": "CreateMissionData"
            },
            "Currency": {
                "type": "string",
                "enum": [
                    "EUR"
                ],
                "x-enum-varnames": [
                    "EUR"
                ],
                "title": "Currency"
            },
            "EntryRounding": {
                "type": "integer",
                "description": "Rounding increment for time entries, expressed as a fraction of the mission's billing unit: half or a quarter of a day/hour, or to the minute.\n",
                "enum": [
                    0,
                    1,
                    2
                ],
                "x-enum-varnames": [
                    "Half",
                    "Quarter",
                    "Minute"
                ],
                "title": "EntryRounding"
            },
            "LoginData": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "password": {
                        "type": "string",
                        "minLength": 1
                    },
                    "remember": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "email",
                    "password"
                ],
                "title": "LoginData"
            },
            "MissionData": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "clientId": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "endClientName": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "billingMode": {
                        "$ref": "#/components/schemas/BillingMode"
                    },
                    "rate": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/MoneyData"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "rounding": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/EntryRounding"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "status": {
                        "$ref": "#/components/schemas/MissionStatus"
                    },
                    "craRequired": {
                        "type": "boolean"
                    },
                    "color": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/Color"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
