{
  "name": "opusline",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "knip": "knip",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:scripts": "node --test scripts/assemble-release-notes.test.mjs scripts/legal-reference.test.mjs",
    "e2e": "pnpm --filter @opusline/e2e e2e",
    "generate-api": "turbo run generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.10",
    "typescript": "^7"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=26"
  },
  "license": "AGPL-3.0-only"
}
